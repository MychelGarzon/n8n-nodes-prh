{
  "name": "n8n-nodes-prh",
  "version": "0.5.4",
  "description": "n8n community node for the Finnish Patent and Registration Office (PRH) Digital Financial Statement (XBRL) open data API",
  "license": "MIT",
  "homepage": "https://github.com/MychelGarzon/n8n-nodes-prh",
  "keywords": [
    "n8n-community-node-package",
    "prh",
    "xbrl",
    "finland",
    "financial-statements",
    "trade-register"
  ],
  "author": {
    "name": "MychelGarzon",
    "email": "mychel.garzon@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MychelGarzon/n8n-nodes-prh.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "jest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/Prh/Prh.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
